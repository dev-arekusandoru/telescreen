{
  "name": "telescreen",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Self-hosted family wall calendar: Google and iCloud calendars, chores, weather, travel, meals and music.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm build:server && pnpm web:build",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @telescreen/web typecheck",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "build:server": "tsc -p tsconfig.build.json",
    "test:web": "pnpm --filter @telescreen/web test",
    "test:all": "vitest run && pnpm test:web",
    "openapi": "tsx scripts/openapi.ts && pnpm --filter @telescreen/web openapi:types",
    "web:dev": "pnpm --filter @telescreen/web dev",
    "web:build": "pnpm --filter @telescreen/web build",
    "e2e": "pnpm web:build && playwright test",
    "e2e:install": "playwright install chromium",
    "docs:dev": "pnpm --filter @telescreen/docs dev",
    "docs:build": "pnpm --filter @telescreen/docs build",
    "docs:serve": "pnpm --filter @telescreen/docs serve"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.15",
    "ical.js": "^2.2.1",
    "timezones-ical-library": "^2.4.0",
    "tsdav": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.18.0"
}
