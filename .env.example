# Copy to .env. docker compose passes it to the container via env_file; `pnpm dev`/`pnpm start`
# load it themselves (variables already set in the environment win).

# Where the SQLite database lives. Default ./data (compose mounts ./data at /data).
TELESCREEN_DATA_DIR=./data

# 32-byte key (64 hex chars) that encrypts calendar account secrets at rest.
# Generate with: openssl rand -hex 32   (losing it means re-connecting accounts)
TELESCREEN_SECRET_KEY=

# 1 = requests to /api/v1 without a token act as the household. Only enable on a
# private network (tailnet). Tokens that are sent are still verified.
TELESCREEN_TRUST_NETWORK=1

# IANA time zone for the household on first boot (default: server's system zone).
# TELESCREEN_TIMEZONE=Europe/Berlin
# TELESCREEN_HOUSEHOLD_NAME=Our Home

# Dev default is 4000; docker compose pins 8788 for the deployed instance.
# PORT=4000
# HOST=0.0.0.0

# --- Calendar accounts -------------------------------------------------------
# Public base URL of this app as the browser reaches it (tailnet HTTPS URL).
# Used for the Google OAuth redirect: ${TELESCREEN_PUBLIC_URL}/auth/google/callback
# TELESCREEN_PUBLIC_URL=https://telescreen.your-tailnet.ts.net
# Non-443 tailscale serve port (e.g. --https=8444)? Include it:
# TELESCREEN_PUBLIC_URL=https://machine.your-tailnet.ts.net:8444

# Google Calendar (see docs/connect/google.md). Leave empty to hide Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Override only if the redirect URI registered in Google Cloud differs from the default above.
# GOOGLE_REDIRECT_URI=

# --- Meals (PantryPal) -------------------------------------------------------
# Base URL of the PantryPal server, reached server-to-server. Unset = Meals module unavailable.
# PANTRYPAL_URL=http://pantrypal:8787
# Browser-facing PantryPal URL for recipe deep links (defaults to PANTRYPAL_URL).
# PANTRYPAL_PUBLIC_URL=https://pantrypal.your-tailnet.ts.net
# Optional bearer token. Leave unset when PantryPal runs with PANTRYPAL_TRUST_NETWORK=1.
# PANTRYPAL_TOKEN=

# --- Music (Spotify) ---------------------------------------------------------
# Client id of your own Spotify app (developer.spotify.com/dashboard). Unset = Music unavailable.
# OAuth uses Authorization Code + PKCE; the refresh token is stored encrypted.
# SPOTIFY_CLIENT_ID=
# Optional: the PKCE flow does not need it, but a Web-app client has one.
# SPOTIFY_CLIENT_SECRET=
# Override only if the redirect URI registered in the Spotify app differs from
# ${TELESCREEN_PUBLIC_URL}/auth/spotify/callback (it must be HTTPS, or 127.0.0.1 on the host).
# SPOTIFY_REDIRECT_URI=

# --- Travel (Google Maps) ----------------------------------------------------
# API key with the Routes API enabled (console.cloud.google.com). Unset = Travel unavailable.
# GOOGLE_MAPS_API_KEY=
